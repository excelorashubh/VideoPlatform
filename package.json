{
  "name": "global-video-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @gvp/web",
    "dev:api": "npm run start:dev --workspace @gvp/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace @gvp/database",
    "db:validate": "npm run db:validate --workspace @gvp/database",
    "db:migrate": "npm run db:migrate --workspace @gvp/database",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
